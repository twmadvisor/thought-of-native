{
  "expo": {
    "name": "thought of",
    "slug": "thought-of",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/thought-of-logo-1024.png",
    "userInterfaceStyle": "light",
    "scheme": "thoughtof",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thoughtof.app",
      "buildNumber": "6",
      "infoPlist": {
        "CFBundleDisplayName": "thought of",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.thoughtof.app"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow thought of to choose a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6a1c542-e326-4642-8e47-e585d603c218"
      }
    }
  }
}
